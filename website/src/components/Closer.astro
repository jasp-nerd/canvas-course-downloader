---
// "When does your Canvas close?": pick a university, see its rule in its own words, with the source.
import { CHECKED, ON_CANVAS, POLICIES } from '../data/policies';

const first = POLICIES.find((p) => p.name === 'RMIT University')!;
// The login rule when the school has one, else the course rule: many US pages only cover courses.
const quote = (p: (typeof POLICIES)[number]) =>
  p.account.match(/"([^"]+)"/)?.[1] ?? p.course.match(/"([^"]+)"/)?.[1] ?? p.account;
// Schools on Canvas without a written rule are in the picker too, pointing at their own Canvas help.
const options = [
  ...POLICIES.map((p) => ({
    name: p.name,
    country: p.country,
    ends: p.ends,
    text: `“${quote(p)}”`,
    source: p.sources[0],
    label: "From the university's own help page",
  })),
  ...ON_CANVAS.map((s) => ({
    name: s.name,
    country: s.country,
    ends: 'No written rule found',
    text: "We couldn't find a written rule on this school's own pages. Ask its IT help desk, and save your courses before you graduate.",
    source: s.source,
    label: "The university's Canvas page",
  })),
].sort((a, b) => a.name.localeCompare(b.name));
// Most visitors are in the US, so it leads; other countries follow alphabetically.
const countries = [...new Set(options.map((o) => o.country))].sort(
  (a, b) => Number(a !== 'United States') - Number(b !== 'United States') || a.localeCompare(b),
);
const checkedDay = new Date(CHECKED).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<div class="closer">
  <h3 id="closer-title">When does your Canvas close?</h3>
  <label class="sr-only" for="school">Your university</label>
  <select id="school" data-school aria-describedby="closer-title">
    {
      countries.map((country) => (
        <optgroup label={country}>
          {options
            .filter((o) => o.country === country)
            .map((o) => (
              <option
                selected={o.name === first.name}
                data-ends={o.ends}
                data-text={o.text}
                data-source={o.source}
                data-label={o.label}
              >
                {o.name}
              </option>
            ))}
        </optgroup>
      ))
    }
  </select>
  <div class="result" data-result aria-live="polite">
    <span class="ends" data-r-ends>{first.ends}</span>
    <span class="school" data-r-school>{first.name}</span>
    <p data-r-text>“{quote(first)}”</p>
    <a href={first.sources[0]} data-r-source>From the university's own help page</a>
  </div>
  <p class="closer-note">
    From each school's own pages, checked on {checkedDay}. Not listed? The {POLICIES.length} rules we found range from the
    day you graduate to never.
  </p>
</div>

<script>
  // Each <option> carries its school's answer.
  const select = document.querySelector<HTMLSelectElement>('[data-school]');
  const result = document.querySelector<HTMLElement>('[data-result]');
  select?.addEventListener('change', () => {
    const o = select.selectedOptions[0];
    if (!o || !result) return;
    result.querySelector('[data-r-ends]')!.textContent = o.dataset.ends ?? '';
    result.querySelector('[data-r-school]')!.textContent = o.textContent;
    result.querySelector('[data-r-text]')!.textContent = o.dataset.text ?? '';
    const link = result.querySelector<HTMLAnchorElement>('[data-r-source]')!;
    link.href = o.dataset.source ?? '#';
    link.textContent = o.dataset.label ?? '';
  });
</script>
